
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        JAVA_HOME = 'C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.21.9-hotspot'
        MAVEN_HOME = 'C:\\apache-maven-3.9.9'
        PATH = "${JAVA_HOME}\\bin;${MAVEN_HOME}\\bin;${env.PATH}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                bat 'java -version'
                bat 'node -v'
                bat 'npm -v'
                bat 'mvn -v'
            }
        }

        stage('Build React Frontend') {
            steps {
                dir('dineease-fullstack/frontend') {
                    bat 'npm ci'
                    bat 'npm run build'
                }
            }
        }

        stage('Build Spring Boot Backend') {
            steps {
                dir('dineease-fullstack/backend') {
                    bat 'mvn -B clean package'
                }
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts(
                    artifacts: 'dineease-fullstack/backend/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: DineEase automatic CI pipeline completed!'
        }

        failure {
            echo 'FAILURE: Check the Jenkins Console Output.'
        }
    }
}
